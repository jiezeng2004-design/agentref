{
  "name": "dsh-agentref",
  "version": "0.1.0-alpha.4",
  "private": true,
  "description": "Local-only AgentRef session mentions for DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/index.js && node --check src/client/index.js && pnpm run build && pnpm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.0-rc.2"
  }
}
